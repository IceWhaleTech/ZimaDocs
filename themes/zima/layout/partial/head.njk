<head prefix="og: http://ogp.me/ns#">
  <meta charset="utf-8">
  <title>{% if page.seo_title %}{{ page.seo_title }} | {{ config.title }}{% elif page.title %}{{ page.title }} | {{ config.title }}{% else %}{{ config.title }}{% endif %}</title>
  <meta http-equiv="X-UA-Compatible" content="IE=Edge,chrome=1">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  {% if page.layout === 'page' or page.layout === 'index' %}
  <script>
    (function () {
      var savedTheme = null;
      try {
        savedTheme = localStorage.getItem('zima-docs-theme');
      } catch (error) {
        savedTheme = null;
      }
      var theme = savedTheme || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.setAttribute('data-theme', theme);
    }());
  </script>
  {% endif %}
  <style>
    html, body { background: #ffffff; }
    html[data-theme="dark"], html[data-theme="dark"] body { background: #0f0f0f; }
  </style>
  <!-- Canonical links -->
  <link rel="canonical" href="{{ canonical_url(page.lang) }}">
  <!-- Alternate links -->
  {% if page.layout == 'page' or page.layout == 'index' %}
    {% for lang, value in site.data.languages %}
    {% if has_translation(lang) %}
  <link rel="alternate" hreflang="{{ lang }}" href="{{ canonical_url(lang) }}">
    {% endif %}
    {% endfor %}
    {% if has_translation('en') %}
  <link rel="alternate" hreflang="x-default" href="{{ canonical_url('en') }}">
    {% endif %}
  {% endif %}
  <!-- FAVICONS ICON -->
  <link rel="icon" href="/favicon.ico" type="image/x-icon" />
  <link rel="shortcut icon" type="image/x-icon" href="/favicon-32x32.png" />

  <!-- Icon -->
  {# <link rel="apple-touch-icon" sizes="57x57" href="{{ url_for('icon/apple-icon-57x57.png') }}">
  <link rel="apple-touch-icon" sizes="60x60" href="{{ url_for('icon/apple-icon-60x60.png') }}">
  <link rel="apple-touch-icon" sizes="72x72" href="{{ url_for('icon/apple-icon-72x72.png') }}">
  <link rel="apple-touch-icon" sizes="76x76" href="{{ url_for('icon/apple-icon-76x76.png') }}">
  <link rel="apple-touch-icon" sizes="114x114" href="{{ url_for('icon/apple-icon-114x114.png') }}">
  <link rel="apple-touch-icon" sizes="120x120" href="{{ url_for('icon/apple-icon-120x120.png') }}">
  <link rel="apple-touch-icon" sizes="144x144" href="{{ url_for('icon/apple-icon-144x144.png') }}">
  <link rel="apple-touch-icon" sizes="152x152" href="{{ url_for('icon/apple-icon-152x152.png') }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ url_for('icon/apple-icon-180x180.png') }}">
  <link rel="icon" type="image/png" sizes="192x192"  href="{{ url_for('icon/android-icon-192x192.png') }}">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ url_for('icon/favicon-32x32.png') }}">
  <link rel="icon" type="image/png" sizes="96x96" href="{{ url_for('icon/favicon-96x96.png') }}">
  <link rel="icon" type="image/png" sizes="16x16" href="{{ url_for('icon/favicon-16x16.png') }}"> #}
  <link rel="manifest" href="{{ url_for('icon//manifest.json') }}">
  <meta name="msapplication-TileColor" content="#f1b335">
  <meta name="msapplication-TileImage" content="{{ url_for('icon/ms-icon-144x144.png') }}">
  <meta name="theme-color" content="#f1b335">

  <!-- Start critical local fonts before the render-blocking stylesheets. -->
  <link rel="preload" href="{{ url_for('/fonts/inter-latin.woff2') }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ url_for('/fonts/britti-sans-regular.woff2') }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ url_for('/fonts/britti-sans-semibold.woff2') }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ url_for('/fonts/britti-sans-bold.woff2') }}" as="font" type="font/woff2" crossorigin>

  <!-- build:css build/css/zima.css -->
  {{ css('css/zima') }}
  {{ css('css/docs-ui') }}
  <!-- endbuild -->
  {% if page.layout === 'index' %}
  {{ css('css/landing') }}
  {% endif %}
  {% if config.algolia[page.lang] %}
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/docsearch.js/1/docsearch.min.css">
  {% endif %}
  
  <!-- Open Graph -->
  {% set description %}
    {% if page.description %}
      {{ page.description }}
    {% else %}
      {{ page.content }}
    {% endif %}
  {% endset %}
  {{ open_graph({
    title: page.seo_title or page.title,
    fb_admins: config.fb_admins,
    twitter_site: config.twitter,
    description: description
  }) }}
  {{ partial('google_analytics') }}

  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "TechArticle",
      "headline": {{ json_ld_string(page.title) }},
      "description": {{ json_ld_string(page.description) }},
      {% if page.feature_image %}"image": {{ json_ld_string(page.feature_image) }},{% endif %}
      "author": {
        "@type": "Organization",
        "name": "ZimaSpace",
        "url": "https://www.zimaspace.com"
      },
      "publisher": {
        "@type": "Organization",
        "name": "ZimaSpace",
        "logo": {
          "@type": "ImageObject",
          "url": "https://www.zimaspace.com/docs/logo.svg"
        }
      },
      "datePublished": {{ json_ld_string(date_xml(page.date)) }}
    }
  </script>

  {% if page.title %}
  {% set _canonicalNavPath = canonical_path_for_nav() %}
  {% set _pathParts = _canonicalNavPath.split('/').slice(1) %}
  {% set _section = _pathParts[0] or '' %}
  {% set _sectionNames = {'zimaos': 'ZimaOS', 'hardware': 'Hardware', 'developer': 'Developer', 'help-center': 'Help Center'} %}
  {% set _sectionName = _sectionNames[_section] %}
  {% set _localePrefix = page.lang + '/' if page.lang and page.lang !== 'en' else '' %}
  {% set _isLanding = _canonicalNavPath.slice(-1) === '/' %}
  {% set _isAppStore = _section === 'zimaos' and _pathParts[1] === 'app-store' %}
  {% if _sectionName %}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "ZimaSpace Docs",
          "item": "https://www.zimaspace.com/docs"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": {{ json_ld_string(_sectionName) }},
          "item": {{ json_ld_string(full_url_for(_localePrefix + _section + '/')) }}
        }{% if _isAppStore or not _isLanding %},{% endif %}
        {% if _isAppStore %}
        {
          "@type": "ListItem",
          "position": 3,
          "name": "App Store",
          "item": {{ json_ld_string(full_url_for(_localePrefix + 'zimaos/app-store/')) }}
        }{% if not _isLanding %},{% endif %}
        {% endif %}
        {% if not _isLanding %}
        {
          "@type": "ListItem",
          "position": {{ 4 if _isAppStore else 3 }},
          "name": {{ json_ld_string(page.title) }}
        }
        {% endif %}
      ]
    }
  </script>
  {% endif %}
  {% endif %}

</head>
