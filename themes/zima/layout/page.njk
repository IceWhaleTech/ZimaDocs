<div class="docs-shell">
  {{ partial('partial/sidebar') }}

  <main class="doc-article" itemscope itemtype="http://schema.org/Article">
    <header class="doc-article__head">
      <h1 itemprop="name">{{ page.title }}</h1>
      <time class="doc-article__meta" datetime="{{ date_xml(page.updated) }}" itemprop="dateModified">{{ __('page.last_updated', date(page.updated, 'YYYY-MM-DD')) }}</time>
    </header>

    <div class="doc-article__body" itemprop="articleBody">
      {{ doc_content(page.content) }}
    </div>

    <footer class="article-footer">
      <time class="article-footer-updated" datetime="{{ date_xml(page.updated) }}" itemprop="dateModified">{{ __('page.last_updated', date(page.updated)) }}</time>
      {{ page_nav() }}
    </footer>
  </main>

  <aside class="doc-toc" role="navigation" aria-label="{{ __('page.contents') }}">
    <nav class="doc-toc__inner">
      {{ toc(page.content, {list_number: false}) }}
    </nav>
  </aside>
</div>
